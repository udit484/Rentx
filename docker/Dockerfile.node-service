FROM node:22-alpine

WORKDIR /app
ARG SERVICE_DIR
ARG SERVICE_PORT
ARG VCS_REF=unknown

LABEL org.opencontainers.image.source="https://github.com/udit484/Rentx" \
      org.opencontainers.image.revision="${VCS_REF}"

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=${SERVICE_PORT}

COPY ${SERVICE_DIR}/package.json ${SERVICE_DIR}/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund \
    && npm cache clean --force

COPY --chown=node:node ${SERVICE_DIR}/src ./src
USER node

EXPOSE ${SERVICE_PORT}
CMD ["npm", "start"]
